@model BusinessManagementSystem.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <span class="text-uppercase text-primary small fw-semibold">
                BusinessFlow Finance
            </span>

            <h2 class="fw-bold mb-1">
                Invoice
            </h2>

            <p class="text-muted mb-0">
                @Model.InvoiceNumber
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="row mb-4">

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Bill To
                    </h6>

                    <h5 class="fw-bold">
                        @Model.Customer?.FullName
                    </h5>

                    <div>
                        @Model.Customer?.Email
                    </div>

                    <div>
                        @Model.Customer?.Phone
                    </div>

                </div>

                <div class="col-md-6 text-md-end">

                    <h6 class="text-muted">
                        Invoice Number
                    </h6>

                    <h5 class="fw-bold">
                        @Model.InvoiceNumber
                    </h5>

                    <div>
                        Invoice Date:
                        @Model.InvoiceDate
                        .ToLocalTime()
                        .ToString("dd MMM yyyy")
                    </div>

                    <div>
                        Due Date:
                        @(Model.DueDate.HasValue
                                                ? Model.DueDate.Value
                                                .ToLocalTime()
                                                .ToString("dd MMM yyyy")
                                                : "-")
                    </div>

                </div>

            </div>

            <hr />

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.InvoiceItems)
                        {
                            <tr>

                                <td>
                                    @item.Description
                                </td>

                                <td>
                                    @item.Quantity
                                </td>

                                <td>
                                    Rs. @item.UnitPrice.ToString("N2")
                                </td>

                                <td class="text-end">
                                    Rs. @item.TotalPrice.ToString("N2")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="row justify-content-end mt-4">

                <div class="col-md-5">

                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <strong>
                            Rs. @Model.SubTotal.ToString("N2")
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax</span>
                        <strong>
                            Rs. @Model.TaxAmount.ToString("N2")
                        </strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <strong>Total</strong>

                        <strong class="fs-4">
                            Rs. @Model.TotalAmount.ToString("N2")
                        </strong>

                    </div>

                </div>

            </div>

            <div class="mt-4">

                @if (Model.Status == "Paid")
                {
                    <span class="badge bg-success fs-6">
                        Paid
                    </span>
                }
                else if (Model.Status == "Cancelled")
                {
                    <span class="badge bg-danger fs-6">
                        Cancelled
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6">
                        Unpaid
                    </span>
                }

            </div>

        </div>

    </div>

</div>