@model IEnumerable<BusinessManagementSystem.Models.Invoice>

@{
    ViewData["Title"] = "My Invoices";
    Layout = "~/Views/Shared/CustomerPortal/_CustomerLayout.cshtml";
}

<div class="customer-page-header">

    <div>
        <span class="customer-eyebrow">
            CUSTOMER PORTAL
        </span>

        <h1>My Invoices</h1>

        <p>
            View your invoices and payment status.
        </p>
    </div>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="customer-card">

    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Order</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var invoice in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @invoice.InvoiceNumber
                                </strong>
                            </td>

                            <td>
                                #@invoice.OrderId
                            </td>

                            <td>
                                Rs. @invoice.TotalAmount.ToString("N2")
                            </td>

                            <td>

                                @if (invoice.Status == "Paid")
                                {
                                    <span class="badge bg-success">
                                        Paid
                                    </span>
                                }
                                else if (invoice.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Unpaid
                                    </span>
                                }

                            </td>

                            <td>
                                @invoice.InvoiceDate
                                .ToLocalTime()
                                .ToString("dd MMM yyyy")
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@invoice.InvoiceId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                    View
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <i class="bi bi-receipt display-4 text-muted"></i>

            <h4 class="mt-3">
                No invoices yet
            </h4>

            <p class="text-muted">
                Your invoices will appear here after an order is created.
            </p>

            <a asp-controller="CustomerServices"
               asp-action="Index"
               class="btn btn-primary">
                Browse Services
            </a>

        </div>
    }

</div>