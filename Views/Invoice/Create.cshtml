@{
}
@model BusinessManagementSystem.Models.Order

@{
    ViewData["Title"] = "Generate Invoice";
}

<div class="container py-4">

    <div class="mb-4">
        <span class="text-uppercase text-primary small fw-semibold">
            BusinessFlow Finance
        </span>

        <h2 class="fw-bold">
            Generate Invoice
        </h2>

        <p class="text-muted">
            Review the order before generating its invoice.
        </p>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Customer
                    </h6>

                    <h5>
                        @Model.Customer?.FullName
                    </h5>

                </div>

                <div class="col-md-6">

                    <h6 class="text-muted">
                        Order
                    </h6>

                    <h5>
                        #@Model.OrderId
                    </h5>

                </div>

            </div>

            <hr />

            <h5 class="mb-3">
                Order Items
            </h5>

            <div class="table-responsive">

                <table class="table">

                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.OrderItems)
                        {
                            var name = item.Service?.Name
                            ?? item.Product?.Name
                            ?? "Order Item";

                            <tr>

                                <td>@name</td>

                                <td>@item.Quantity</td>

                                <td>
                                    Rs. @item.UnitPrice.ToString("N2")
                                </td>

                                <td>
                                    Rs. @item.TotalPrice.ToString("N2")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="text-end mt-4">

                <h4>
                    Total:
                    <strong>
                        Rs. @Model.TotalAmount.ToString("N2")
                    </strong>
                </h4>

            </div>

            <form asp-action="Create"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="orderId"
                       value="@Model.OrderId" />

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-receipt"></i>
                    Generate Invoice
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>