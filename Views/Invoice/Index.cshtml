@model IEnumerable<BusinessManagementSystem.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="text-uppercase text-primary small fw-semibold">
                BusinessFlow Finance
            </span>
            <h2 class="fw-bold mb-1">Invoices</h2>
            <p class="text-muted mb-0">
                Manage customer invoices and record received payments.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form method="get" asp-action="Index" class="row g-2 mb-4">
                <div class="col-md-4">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Unpaid" selected="@(ViewBag.Status == "Unpaid")">Unpaid</option>
                        <option value="Paid" selected="@(ViewBag.Status == "Paid")">Paid</option>
                        <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                    </select>
                </div>

                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Customer</th>
                            <th>Order</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th style="min-width: 280px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@invoice.InvoiceNumber</strong>
                                </td>

                                <td>
                                    @(invoice.Customer?.FullName ?? "N/A")
                                </td>

                                <td>#@invoice.OrderId</td>

                                <td class="text-nowrap">
                                    Rs. @invoice.TotalAmount.ToString("N2")
                                </td>

                                <td>
                                    @if (invoice.Status == "Paid")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (invoice.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Unpaid</span>
                                    }
                                </td>

                                <td class="text-nowrap">
                                    @invoice.InvoiceDate.ToLocalTime().ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <div class="d-flex flex-wrap align-items-center gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@invoice.InvoiceId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View invoice details">
                                            <i class="bi bi-eye"></i> View Invoice
                                        </a>

                                        @if (invoice.Status == "Unpaid")
                                        {
                                            <a asp-controller="Payment"
                                               asp-action="Create"
                                               asp-route-invoiceId="@invoice.InvoiceId"
                                               class="btn btn-sm btn-success"
                                               title="Record a payment for this invoice">
                                                <i class="bi bi-cash-coin"></i> Record Payment
                                            </a>
                                        }

                                        @if (invoice.Status != "Cancelled")
                                        {
                                            <form asp-action="UpdateStatus"
                                                  method="post"
                                                  class="d-flex align-items-center gap-1">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@invoice.InvoiceId" />

                                                <select name="status"
                                                        class="form-select form-select-sm"
                                                        aria-label="Change invoice status"
                                                        style="width: 125px;">
                                                    <option value="Unpaid" selected="@(invoice.Status == "Unpaid")">Unpaid</option>
                                                    <option value="Paid" selected="@(invoice.Status == "Paid")">Paid</option>
                                                    <option value="Cancelled">Cancelled</option>
                                                </select>

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    Update Status
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt display-4 text-muted"></i>
                    <h5 class="mt-3">No invoices found</h5>
                    <p class="text-muted">
                        Generate an invoice from an existing order.
                    </p>
                    <a asp-controller="Order"
                       asp-action="Index"
                       class="btn btn-primary">
                        <i class="bi bi-bag-check"></i> View Orders
                    </a>
                </div>
            }
        </div>
    </div>
</div>
