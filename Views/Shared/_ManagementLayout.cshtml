
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BusinessFlow</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BusinessManagementSystem.styles.css" asp-append-version="true" />

    <style>
        body { margin: 0; background: #0b1220; color: #e5e7eb; }
        .management-sidebar {
            position: fixed; inset: 0 auto 0 0; width: 250px;
            background: #111b2e; border-right: 1px solid #263449;
            padding: 24px 16px; overflow-y: auto; z-index: 1040;
        }
        .management-brand {
            display: block; color: white; font-size: 23px;
            font-weight: 800; text-decoration: none;
            padding: 0 10px 24px; border-bottom: 1px solid #263449;
        }
        .management-brand span { color: #60a5fa; }
        .menu-heading {
            color: #8392a8; font-size: 11px; font-weight: 700;
            letter-spacing: 1.4px; margin: 24px 10px 10px;
        }
        .management-link {
            display: block; padding: 11px 12px; margin: 4px 0;
            color: #cbd5e1; text-decoration: none; border-radius: 8px;
            transition: background .15s ease, color .15s ease;
        }
        .management-link:hover, .management-link.active {
            color: white; background: #1e3a5f;
        }
        .management-main { margin-left: 250px; min-height: 100vh; }
        .management-topbar {
            min-height: 76px; padding: 16px 28px;
            background: #111b2e; border-bottom: 1px solid #263449;
            display: flex; align-items: center; justify-content: space-between;
            gap: 16px;
        }
        .management-content { padding: 28px; }
        .management-content .card {
            background: #111b2e; color: #e5e7eb;
            border: 1px solid #263449;
        }
        .management-content .text-muted { color: #9caec4 !important; }
        .sidebar-toggle {
            display: none; background: #1e3a5f; color: white;
            border: 0; padding: 8px 12px; border-radius: 6px;
        }
        .management-overlay { display: none; }

        @@media (max-width: 991.98px) {
            .management-sidebar {
                transform: translateX(-100%);
                transition: transform .2s ease;
            }
            .management-sidebar.sidebar-open { transform: translateX(0); }
            .management-main { margin-left: 0; }
            .sidebar-toggle { display: inline-block; }
            .management-topbar { padding: 14px 16px; }
            .management-content { padding: 18px 14px; }
            .management-overlay.overlay-open {
                display: block; position: fixed; inset: 0;
                background: rgba(0,0,0,.6); z-index: 1030;
            }
        }
    </style>
</head>
<body>
    <aside id="managementSidebar" class="management-sidebar">
        <a asp-controller="Dashboard" asp-action="Index" class="management-brand">
            Business<span>Flow</span>
        </a>

        <div class="menu-heading">WORKSPACE</div>
        <a class="management-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>

        @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff"))
        {
            <div class="menu-heading">BUSINESS MANAGEMENT</div>
            <a class="management-link" asp-controller="Customer" asp-action="Index">Customers</a>
            <a class="management-link" asp-controller="Product" asp-action="Index">Products</a>
            <a class="management-link" asp-controller="Service" asp-action="Index">Services</a>
            <a class="management-link" asp-controller="ServiceRequestManagement" asp-action="Index">Service Requests</a>
            <a class="management-link" asp-controller="Order" asp-action="Index">Orders</a>
            <a class="management-link" asp-controller="Invoice" asp-action="Index">Invoices</a>
            <a class="management-link" asp-controller="Payment" asp-action="Index">Payments</a>
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="menu-heading">ADMINISTRATION</div>
            <a class="management-link" asp-controller="Account" asp-action="Register">Register Customer</a>

            <a class="management-link"
               asp-controller="UserManagement"
               asp-action="Index">User Management</a>

        }

        <div class="menu-heading">WEBSITE</div>
        <a class="management-link" asp-controller="Home" asp-action="Index">Public Website</a>
    </aside>

    <div id="managementOverlay" class="management-overlay"></div>

    <div class="management-main">
        <header class="management-topbar">
            <div class="d-flex align-items-center gap-3">
                <button id="sidebarToggle" type="button" class="sidebar-toggle"
                        aria-label="Toggle navigation" aria-expanded="false">
                    Menu
                </button>
                <div>
                    <div class="fw-bold">@ViewData["Title"]</div>
                    <small style="color:#9caec4">Business Management System</small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="d-none d-sm-inline">Hello, @User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                </form>
            </div>
        </header>

        <main class="management-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const sidebar = document.getElementById("managementSidebar");
        const toggle = document.getElementById("sidebarToggle");
        const overlay = document.getElementById("managementOverlay");

        function setSidebar(open) {
            sidebar.classList.toggle("sidebar-open", open);
            overlay.classList.toggle("overlay-open", open);
            toggle.setAttribute("aria-expanded", String(open));
        }

        toggle.addEventListener("click", () => {
            setSidebar(!sidebar.classList.contains("sidebar-open"));
        });
        overlay.addEventListener("click", () => setSidebar(false));

        const currentPath = window.location.pathname.toLowerCase();
        document.querySelectorAll(".management-link").forEach(link => {
            const href = new URL(link.href).pathname.toLowerCase();
            if (href !== "/" && currentPath.startsWith(href)) {
                link.classList.add("active");
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
