@model BusinessManagementSystem.ViewModels.CreateOrderViewModel

@{
    ViewData["Title"] = "Create Order";

    var customers = ViewBag.Customers
        as IEnumerable<BusinessManagementSystem.Models.Customer>
        ?? Enumerable.Empty<BusinessManagementSystem.Models.Customer>();

    var products = ViewBag.Products
        as IEnumerable<BusinessManagementSystem.Models.Product>
        ?? Enumerable.Empty<BusinessManagementSystem.Models.Product>();

    var services = ViewBag.Services
        as IEnumerable<BusinessManagementSystem.Models.Service>
        ?? Enumerable.Empty<BusinessManagementSystem.Models.Service>();
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
        <h2 class="fw-bold mt-3">Create Order</h2>
        <p class="text-muted">Create an order for a customer using a product or service.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label">Customer</label>
                        <select asp-for="CustomerId" class="form-select">
                            <option value="">Select Customer</option>
                            @foreach (var customer in customers)
                            {
                                <option value="@customer.CustomerId">
                                    @customer.FullName
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ItemType" class="form-label">Order Type</label>
                        <select asp-for="ItemType" id="itemType" class="form-select">
                            <option value="Product">Product</option>
                            <option value="Service">Service</option>
                        </select>
                        <span asp-validation-for="ItemType"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6" id="productContainer">
                        <label class="form-label">Product</label>
                        <select id="productSelect" class="form-select">
                            <option value="">Select Product</option>
                            @foreach (var product in products)
                            {
                                <option value="@product.ProductId"
                                        selected="@(Model.ItemType == "Product" && Model.ItemId == product.ProductId)">
                                    @product.Name - Rs @product.Price.ToString("N2")
                                    (Stock: @product.StockQuantity)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6" id="serviceContainer">
                        <label class="form-label">Service</label>
                        <select id="serviceSelect" class="form-select">
                            <option value="">Select Service</option>
                            @foreach (var service in services)
                            {
                                <option value="@service.ServiceId"
                                        selected="@(Model.ItemType == "Service" && Model.ItemId == service.ServiceId)">
                                    @service.Name - Rs @service.Price.ToString("N2")
                                </option>
                            }
                        </select>
                    </div>

                    <input asp-for="ItemId" type="hidden" />
                    <span asp-validation-for="ItemId"
                          class="text-danger"></span>

                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label">Quantity</label>
                        <input asp-for="Quantity" type="number"
                               class="form-control" min="1" max="100000" />
                        <span asp-validation-for="Quantity"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Create Order
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const itemType = document.getElementById("itemType");
            const productSelect = document.getElementById("productSelect");
            const serviceSelect = document.getElementById("serviceSelect");
            const productContainer = document.getElementById("productContainer");
            const serviceContainer = document.getElementById("serviceContainer");
            const itemId = document.getElementById("ItemId");

            function updateItemSelection() {
                const isProduct = itemType.value === "Product";

                productContainer.hidden = !isProduct;
                serviceContainer.hidden = isProduct;

                itemId.value = isProduct
                    ? productSelect.value
                    : serviceSelect.value;
            }

            itemType.addEventListener("change", updateItemSelection);
            productSelect.addEventListener("change", updateItemSelection);
            serviceSelect.addEventListener("change", updateItemSelection);

            updateItemSelection();
        });
    </script>
}
