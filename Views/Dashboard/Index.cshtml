@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="fw-bold">Business Dashboard</h1>
    <p class="text-muted">
        Welcome back, @User.Identity?.Name.
        Here is your business overview.
    </p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card h-100 p-4">
            <h6 class="text-muted">Active Customers</h6>
            <h2 class="fw-bold">@ViewBag.TotalCustomers</h2>
            <a asp-controller="Customer" asp-action="Index"
               class="btn btn-primary mt-auto">Manage Customers</a>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card h-100 p-4">
            <h6 class="text-muted">Active Products</h6>
            <h2 class="fw-bold">@ViewBag.TotalProducts</h2>
            <a asp-controller="Product" asp-action="Index"
               class="btn btn-primary mt-auto">Manage Products</a>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card h-100 p-4">
            <h6 class="text-muted">Active Services</h6>
            <h2 class="fw-bold">@ViewBag.TotalServices</h2>
            <a asp-controller="Service" asp-action="Index"
               class="btn btn-primary mt-auto">Manage Services</a>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card h-100 p-4">
            <h6 class="text-muted">Pending Orders</h6>
            <h2 class="fw-bold">@ViewBag.PendingOrders</h2>
            <a asp-controller="Order" asp-action="Index"
               asp-route-status="Pending"
               class="btn btn-primary mt-auto">View Orders</a>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card h-100 p-4">
            <h6 class="text-muted">Pending Service Requests</h6>
            <h2 class="fw-bold">@ViewBag.PendingServiceRequests</h2>
            <a asp-controller="ServiceRequestManagement"
               asp-action="Index"
               class="btn btn-primary mt-auto">View Requests</a>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card h-100 p-4">
            <h6 class="text-muted">Unpaid Invoices</h6>
            <h2 class="fw-bold">@ViewBag.UnpaidInvoices</h2>
            <a asp-controller="Invoice" asp-action="Index"
               asp-route-status="Unpaid"
               class="btn btn-primary mt-auto">View Invoices</a>
        </div>
    </div>

    <div class="col-sm-6 col-xl-4">
        <div class="card h-100 p-4">
            <div class="card-body px-0">
                <h5>Payments</h5>
                <p class="text-muted">
                    Record and review received payments.
                </p>
                <a asp-controller="Payment" asp-action="Index"
                   class="btn btn-primary">Manage Payments</a>
            </div>
        </div>
    </div>
</div>
