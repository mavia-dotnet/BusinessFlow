@model BusinessManagementSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Product Details</h1>
            <p class="text-muted">
                View complete product information.
            </p>
        </div>

        <div>
            <a asp-action="Edit"
               asp-route-id="@Model.ProductId"
               class="btn btn-primary">
                Edit Product
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Name</small>
                    <h5 class="fw-semibold">@Model.Name</h5>
                </div>

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Type</small>
                    <h5 class="fw-semibold">@Model.Type</h5>
                </div>

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Category</small>
                    <h5 class="fw-semibold">
                        @(Model.Category ?? "Not specified")
                    </h5>
                </div>

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Selling Price</small>
                    <h5 class="fw-semibold">
                        Rs. @Model.Price.ToString("N2")
                    </h5>
                </div>

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Cost Price</small>
                    <h5 class="fw-semibold">
                        Rs. @Model.CostPrice.ToString("N2")
                    </h5>
                </div>

                <div class="col-md-6 mb-4">
                    <small class="text-muted">Stock Quantity</small>
                    <h5 class="fw-semibold">
                        @Model.StockQuantity
                    </h5>
                </div>

                <div class="col-md-12 mb-4">
                    <small class="text-muted">Description</small>
                    <h5 class="fw-semibold">
                        @(Model.Description ?? "Not provided")
                    </h5>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Created At</small>
                    <h5 class="fw-semibold">
                        @Model.CreatedAt
                        .ToLocalTime()
                        .ToString("dd MMM yyyy, hh:mm tt")
                    </h5>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Status</small>
                    <h5 class="fw-semibold text-success">
                        Active
                    </h5>
                </div>

            </div>

        </div>
    </div>

</div>