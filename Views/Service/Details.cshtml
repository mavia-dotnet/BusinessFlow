@model BusinessManagementSystem.Models.Service

@{
    ViewData["Title"] = "Service Details";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Services
        </a>

        <h2 class="fw-bold mt-3">Service Details</h2>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-8">

                    <span class="badge bg-primary mb-3">
                        @(Model.Category ?? "General")
                    </span>

                    <h2 class="fw-bold">@Model.Name</h2>

                    <p class="text-muted mt-3">
                        @(Model.Description ?? "No description available.")
                    </p>

                </div>

                <div class="col-md-4">

                    <div class="bg-light rounded p-4">

                        <small class="text-muted">
                            Service Price
                        </small>

                        <h3 class="fw-bold mt-1">
                            Rs @Model.Price.ToString("N2")
                        </h3>

                        <hr />

                        <small class="text-muted">
                            Created
                        </small>

                        <p class="mb-0">
                            @Model.CreatedAt.ToString("dd MMM yyyy")
                        </p>

                    </div>

                </div>

            </div>

            <div class="mt-4">

                <a asp-action="Edit"
                   asp-route-id="@Model.ServiceId"
                   class="btn btn-primary">
                    <i class="bi bi-pencil"></i>
                    Edit Service
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Back
                </a>

            </div>

        </div>
    </div>

</div>