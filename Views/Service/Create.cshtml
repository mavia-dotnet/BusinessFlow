@model BusinessManagementSystem.Models.Service

@{
    ViewData["Title"] = "Add Service";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Services
        </a>

        <h2 class="fw-bold mt-3">Add Service</h2>
        <p class="text-muted">
            Create a new service for your business.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label">
                            Service Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="e.g. Web Development" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Category"
                               class="form-label">
                            Category
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="e.g. Development" />

                        <span asp-validation-for="Category"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price"
                               class="form-label">
                            Price
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">Rs</span>

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="0.00" />
                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description"
                               class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe the service..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-lg"></i>
                        Save Service
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}