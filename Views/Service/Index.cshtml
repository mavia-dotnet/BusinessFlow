@model IEnumerable<BusinessManagementSystem.Models.Service>

@{
    ViewData["Title"] = "Services";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Services</h2>
            <p class="text-muted mb-0">
                Manage your business services.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Service
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search services..." />

            <button type="submit" class="btn btn-dark">
                <i class="bi bi-search"></i>
                Search
            </button>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-layers fs-1 text-muted"></i>
                    <h5 class="mt-3">No services found</h5>
                    <p class="text-muted">
                        Add your first service to get started.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var service in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@service.Name</strong>
                                    </td>

                                    <td>
                                        @(service.Category ?? "-")
                                    </td>

                                    <td>
                                        Rs @service.Price.ToString("N2")
                                    </td>

                                    <td>
                                        @service.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@service.ServiceId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="View Details"
                                           data-bs-toggle="tooltip">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@service.ServiceId"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Service"
                                           data-bs-toggle="tooltip">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@service.ServiceId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete Service"
                                                    data-bs-toggle="tooltip"
                                                    onclick="return confirm('Are you sure you want to delete this service?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>