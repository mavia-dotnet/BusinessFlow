<section id="how-it-works" class="how-it-works-section">
    <div class="container">

        <div class="section-heading text-center">

            <span class="section-badge">
                Simple Workflow
            </span>

            <h2>
                How BusinessFlow Works
            </h2>

            <p>
                Bring your customers, products, orders and payments
                together in a simple business workflow.
            </p>

        </div>


        <div class="row g-4 mt-5">

            <!-- Step 1 -->
            <div class="col-md-4">
                <div class="workflow-step">

                    <div class="step-number">
                        01
                    </div>

                    <h4>
                        Set Up Your Business
                    </h4>

                    <p>
                        Add your business information, products,
                        services, staff and customers.
                    </p>

                </div>
            </div>


            <!-- Step 2 -->
            <div class="col-md-4">
                <div class="workflow-step">

                    <div class="step-number">
                        02
                    </div>

                    <h4>
                        Manage Daily Operations
                    </h4>

                    <p>
                        Create orders, generate invoices, record
                        payments and manage inventory.
                    </p>

                </div>
            </div>


            <!-- Step 3 -->
            <div class="col-md-4">
                <div class="workflow-step">

                    <div class="step-number">
                        03
                    </div>

                    <h4>
                        Understand Your Business
                    </h4>

