<!-- CTA -->

<section id="get-started" class="cta-section">
    <div class="container">

        <div class="cta-content text-center">

            <span class="section-badge">
                Ready To Get Started?
            </span>

            <h2>
                Take Control Of Your Business
            </h2>

            <p>
                Manage your business operations from one
                centralized platform.
            </p>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-primary btn-lg px-5">
                Get Started
            </a>

        </div>

    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-5">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="section-badge">GET IN TOUCH</span>
            <h2 class="fw-bold mt-3">Let's Talk About Your Business</h2>
            <p class="text-muted">
                Have a question about BusinessFlow? Send us a message.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4">
                    <form id="contactForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="contactName" class="form-label">Full Name</label>
                                <input id="contactName" type="text"
                                       class="form-control"
                                       placeholder="Enter your name" required />
                            </div>

                            <div class="col-md-6">
                                <label for="contactEmail" class="form-label">Email Address</label>
                                <input id="contactEmail" type="email"
                                       class="form-control"
                                       placeholder="you@example.com" required />
                            </div>

                            <div class="col-12">
                                <label for="contactSubject" class="form-label">Subject</label>
                                <input id="contactSubject" type="text"
                                       class="form-control"
                                       placeholder="How can we help?" required />
                            </div>

                            <div class="col-12">
                                <label for="contactMessage" class="form-label">Message</label>
                                <textarea id="contactMessage"
                                          class="form-control"
                                          rows="5"
                                          placeholder="Write your message..."
                                          required></textarea>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary px-4">
                                    Send Message
                                </button>
                                <p id="contactFormNotice"
                                   class="small mt-3 mb-0"
                                   role="status"></p>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Support Section -->
<section id="support" class="py-5 bg-light">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="section-badge">SUPPORT CENTER</span>
            <h2 class="fw-bold mt-3">How Can We Help?</h2>
            <p class="text-muted">
                Find answers to common questions about using BusinessFlow.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h5 class="fw-bold">Account & Login</h5>
                    <p class="text-muted mb-0">
                        Need help accessing your account? Make sure you use
                        the email and password associated with your account.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h5 class="fw-bold">Business Management</h5>
                    <p class="text-muted mb-0">
                        Manage customers, products, services, orders,
                        invoices and payment records from the relevant modules.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-4">
                    <h5 class="fw-bold">Need More Help?</h5>
                    <p class="text-muted mb-3">
                        Use the contact form to describe your question or issue.
                    </p>
                    <a href="#contact" class="btn btn-outline-primary align-self-start">
                        Contact Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.getElementById("contactForm")?.addEventListener("submit", function (event) {
        event.preventDefault();

        document.getElementById("contactFormNotice").textContent =
            "This demo form is not connected to a message service yet.";

        document.getElementById("contactFormNotice").className =
            "small mt-3 mb-0 text-warning";
    });
</script>