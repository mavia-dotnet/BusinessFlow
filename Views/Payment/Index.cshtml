@model IEnumerable<BusinessManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Payments</h2>
            <p class="text-muted mb-0">Track received payments and transactions.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Invoice</th>
                        <th>Customer</th>
                        <th>Method</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>@payment.TransactionReference</td>
                            <td>@(payment.Invoice?.InvoiceNumber ?? "N/A")</td>
                            <td>@(payment.Invoice?.Customer?.FullName ?? "N/A")</td>
                            <td>@payment.PaymentMethod</td>
                            <td>Rs. @payment.Amount.ToString("N2")</td>
                            <td>@payment.PaymentDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                @if (payment.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@payment.Status</span>
                                }
                            </td>
                            <td>
                                @if (payment.Status == "Completed")
                                {
                                    <form asp-action="Cancel" method="post" class="d-inline"
                                          onsubmit="return confirm('Cancel this payment record?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@payment.PaymentId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle"></i> Cancel Payment
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-credit-card display-4"></i>
                    <h5 class="mt-3">No payments recorded</h5>
                    <p>Record a payment from an invoice to see it here.</p>
                    <a asp-controller="Invoice" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-receipt"></i> View Invoices
                    </a>
                </div>
            }
        </div>
    </div>
</div>
