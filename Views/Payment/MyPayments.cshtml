@model IEnumerable<BusinessManagementSystem.Models.Payment>

@{
    ViewData["Title"] = "My Payments";
    Layout = "~/Views/Shared/CustomerPortal/_CustomerLayout.cshtml";
}

<div class="customer-page-header">
    <div>
        <span class="customer-eyebrow">CUSTOMER PORTAL</span>
        <h1>My Payments</h1>
        <p>View your payment history and transaction references.</p>
    </div>
</div>

<div class="customer-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Invoice</th>
                        <th>Payment Method</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td><strong>@payment.TransactionReference</strong></td>
                            <td>@(payment.Invoice?.InvoiceNumber ?? "N/A")</td>
                            <td>@payment.PaymentMethod</td>
                            <td>Rs. @payment.Amount.ToString("N2")</td>
                            <td>@payment.PaymentDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                @if (payment.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@payment.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-credit-card display-4 text-muted"></i>
            <h4 class="mt-3">No payments yet</h4>
            <p class="text-muted">Your recorded payments will appear here.</p>
            <a asp-controller="Invoice"
               asp-action="MyInvoices"
               class="btn btn-primary">
                <i class="bi bi-receipt"></i> View My Invoices
            </a>
        </div>
    }
</div>
